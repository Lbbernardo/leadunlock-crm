# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (public key for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Stripe (secret key for API routes — never expose to frontend)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Supabase service role (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# Webhook auth token (generated by you — use a random 32-char string)
WEBHOOK_SECRET=your-webhook-secret-token
